{
  "name": "horizon-of-knowledge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "content:validate": "tsx scripts/content-cli.ts validate",
    "content:build": "tsx scripts/content-cli.ts build",
    "content:stats": "tsx scripts/content-cli.ts stats",
    "content:import": "tsx scripts/content-cli.ts import",
    "content:apply": "tsx scripts/content-cli.ts apply",
    "content:export": "tsx scripts/content-cli.ts export",
    "content:links": "tsx scripts/content-cli.ts links",
    "content:ai-drafts": "tsx scripts/gemini-drafts.ts",
    "prebuild": "tsx scripts/content-cli.ts build",
    "test": "tsx --test src/content/*.test.ts src/game/*.test.ts src/platform/*.test.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "android:assets": "npx @capacitor/assets@3.0.5 generate --android --iconBackgroundColor '#0B0F19' --splashBackgroundColor '#0B0F19'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
